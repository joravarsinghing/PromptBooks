<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_canvas">

    <!-- Minimal Apple-style header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical"
        android:background="@color/background_canvas">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PromptBooks"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02"
            android:textColor="@color/text_primary" />

        <ImageView
            android:id="@+id/btnSupport"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_support"
            app:tint="@color/text_secondary"
            android:contentDescription="Support"
            android:padding="6dp"
            android:background="@drawable/bg_icon_button"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Fragment container -->
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Hairline divider above tab bar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/divider_hairline" />

    <!-- Apple-style frosted bottom tab bar -->
    <LinearLayout
        android:id="@+id/bottomTabBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/surface_white"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- Chat Tab -->
        <LinearLayout
            android:id="@+id/tabChat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/iconChat"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_tab_chat"
                android:contentDescription="Chat" />

            <TextView
                android:id="@+id/labelChat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chat"
                android:textSize="10sp"
                android:letterSpacing="0.01"
                android:layout_marginTop="4dp"
                android:textColor="@color/tab_active" />
        </LinearLayout>

        <!-- Dashboard Tab -->
        <LinearLayout
            android:id="@+id/tabDashboard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/iconDashboard"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_tab_dashboard"
                android:contentDescription="Dashboard" />

            <TextView
                android:id="@+id/labelDashboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dashboard"
                android:textSize="10sp"
                android:letterSpacing="0.01"
                android:layout_marginTop="4dp"
                android:textColor="@color/tab_inactive" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
