<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_canvas"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="4dp">

    <!-- Summary Cards Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:layout_marginBottom="12dp">

        <!-- Net Profit Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NET PROFIT"
                android:textSize="11sp"
                android:letterSpacing="0.06"
                android:textColor="@color/text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All time"
                android:textSize="10sp"
                android:textColor="@color/text_tertiary"
                android:layout_marginTop="1dp" />

            <TextView
                android:id="@+id/tvNetProfit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 AED"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="-0.01"
                android:textColor="@color/primary_blue"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Sales Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SALES"
                android:textSize="11sp"
                android:letterSpacing="0.06"
                android:textColor="@color/text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All time"
                android:textSize="10sp"
                android:textColor="@color/text_tertiary"
                android:layout_marginTop="1dp" />

            <TextView
                android:id="@+id/tvSales"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 AED"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="-0.01"
                android:textColor="@color/income_green"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Balance Trend Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/bg_card"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BALANCE TREND"
                    android:textSize="11sp"
                    android:letterSpacing="0.06"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/tvCurrentBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 AED"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.01"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/chartBalanceTrend"
            android:layout_width="match_parent"
            android:layout_height="140dp" />
    </LinearLayout>

    <!-- Recent Transactions header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RECENT TRANSACTIONS"
        android:textSize="11sp"
        android:letterSpacing="0.06"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="8dp" />

    <!-- Transactions Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_card">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ScrollView
                android:id="@+id/scrollTransactions"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:id="@+id/containerTransactions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <TextView
                android:id="@+id/tvEmptyState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="No transactions yet"
                android:textColor="@color/text_tertiary"
                android:textSize="15sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/btnNewChat"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="New Chat"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_button_secondary" />

        <View android:layout_width="12dp" android:layout_height="1dp" />

        <TextView
            android:id="@+id/btnExportData"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Export Data"
            android:textColor="@color/primary_blue"
            android:textSize="15sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_button_secondary" />
    </LinearLayout>

</LinearLayout>
